# HCC Compression Advisor Configuration
# Copy this file to .env and update with your values

# Authentication
DASHBOARD_PASSWORD=YourSecurePassword123!

# Central Database Connection (stores all analysis results)
# This is the centralized Oracle database where analysis results,
# strategies, and target database registrations are stored.
CENTRAL_DB_HOST=localhost
CENTRAL_DB_PORT=1521
CENTRAL_DB_SERVICE=FREEPDB1
CENTRAL_DB_USER=COMPRESSION_MGR
CENTRAL_DB_PASSWORD=your_central_db_password

# Legacy Database Connection (backward compatibility / single-DB mode)
# Used as fallback if CENTRAL_DB_* vars are not set
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=FREEPDB1
DB_USER=COMPRESSION_MGR
DB_PASSWORD=your_db_password

# Encryption key for target database password storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ORDS REST API (optional - not required for core functionality)
#ORDS_BASE_URL=https://localhost:8443/ords/compression_mgr
#ORDS_USERNAME=COMPRESSION_MGR
#ORDS_PASSWORD=your_ords_password

# SSL Configuration
SSL_ENABLED=true
SSL_CERT_FILE=ssl/cert.pem
SSL_KEY_FILE=ssl/key.pem

# Application Settings
APP_TITLE=HCC Compression Advisor
APP_ICON=📊
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
